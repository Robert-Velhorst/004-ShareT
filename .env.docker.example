# ============================================================
# ShareT Docker Deployment — Environment Variables
# Copy this file to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker
# ============================================================

NODE_ENV=production
PORT=5005
DATA_DIR=/app/backend/data
SHARET_ADMIN_EMAIL=noodzakelijkonline@gmail.com

# ============================================================
# TRELLO API
# Get your key at: https://trello.com/app-key
# ============================================================
TRELLO_API_KEY=your_trello_api_key_here
TRELLO_API_SECRET=your_trello_api_secret_here
TRELLO_CALLBACK_URL=https://your-public-url.example.com
# Optional override; normally derived from PUBLIC_URL.
TRELLO_WEBHOOK_CALLBACK_URL=

# Dedicated ShareT relay account for freelancer comments and notifications.
# Add it to each relevant BOARD once; ShareT assigns it to cards automatically.
# Generate the token while logged in as the relay account. Keep it secret.
TRELLO_BOT_TOKEN=
SHARET_TRELLO_NOTIFY_USERNAME=your_owner_trello_username
# Set false after the relay is configured so a relay failure cannot silently
# fall back to the owner's token and suppress the notification bell.
SHARET_ALLOW_OWNER_COMMENT_FALLBACK=false
# Subscribe the owner to each shared card. This delivers the bell on its own,
# independently of the @mention, and keeps working if the mention is removed
# or SHARET_TRELLO_NOTIFY_USERNAME is unset. Set false to disable.
SHARET_AUTO_WATCH_CARDS=true

# ============================================================
# PUBLIC URLS — set these to your Hetzner domain or localhost for local development
# ============================================================
PUBLIC_URL=https://your-public-url.example.com
FRONTEND_URL=https://your-public-url.example.com
CORS_ORIGIN=https://your-public-url.example.com,http://localhost:5005

# ============================================================
# SECURITY SECRETS — generate with: openssl rand -hex 32
# ============================================================
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_REFRESH_EXPIRE=30d
ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# ============================================================
# EMAIL (Gmail SMTP) — password resets, freelancer verification, and replies
# Use an App Password: https://myaccount.google.com/apppasswords
# ============================================================
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=ShareT <your_gmail@gmail.com>
# Recovery scan. Signed Trello webhooks normally deliver replies immediately.
SHARET_REPLY_POLL_INTERVAL_MS=60000
SHARET_PARTICIPANT_SESSION_DAYS=90
SHARET_ACCESS_LOG_RETENTION_DAYS=90

# ============================================================
# OPTIONAL INTEGRATIONS
# ============================================================

# CouchDB cloud sync (leave empty for local-only mode)
COUCHDB_URL=
COUCHDB_AUTH=

# MongoDB (legacy — not used with PouchDB mode)
MONGODB_URI=

# GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=

# Stripe payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=


# ============================================================
# OTHER
# ============================================================
MAINTENANCE_MODE=false
SHARET_DISABLE_PUBLIC_ACCESS=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOG_LEVEL=info
ENABLE_RESOURCE_TRACKING=true
RESOURCE_PRICE_MULTIPLIER=2
