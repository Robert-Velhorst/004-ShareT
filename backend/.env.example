# ShareT Backend Configuration
# PouchDB Edition - no database installation required.

# Server Configuration
PORT=5005
NODE_ENV=development

# Public URL
# Use a stable HTTPS URL from Cloudflare Tunnel, ngrok static domain, VPS, Railway, Render, etc.
# Do not use a changing temporary URL for production links or Trello OAuth.
PUBLIC_URL=http://localhost:5005
FRONTEND_URL=http://localhost:5005
CORS_ORIGIN=http://localhost:5005

# Trello API Credentials (Required)
# Get these at: https://trello.com/app-key
TRELLO_API_KEY=your_api_key_here
TRELLO_API_SECRET=your_api_secret_here
TRELLO_CALLBACK_URL=http://localhost:5005/api/trello/callback
# Optional override. By default ShareT uses PUBLIC_URL + /api/trello-webhooks/callback.
TRELLO_WEBHOOK_CALLBACK_URL=

# Trello notification identity
# Required for a red/unread Trello bell: create a dedicated Trello member such as
# "ShareT Updates", add it to the relevant boards, and generate a token for it.
# It must be a DIFFERENT Trello member from SHARET_TRELLO_NOTIFY_USERNAME.
# Freelancers do not sign in to Trello; ShareT posts on their behalf through this relay.
# Add the relay to each relevant BOARD once. ShareT automatically assigns it to
# an individual card before posting the first freelancer comment on that card.
TRELLO_BOT_TOKEN=
SHARET_TRELLO_NOTIFY_USERNAME=noodzakelijkonline
# The fallback preserves comment delivery but cannot notify the owner when it posts
# with that owner's own token. Set false if a missing relay should fail closed.
SHARET_ALLOW_OWNER_COMMENT_FALLBACK=true

# Email delivery
# SMTP is required to verify freelancer email addresses and notify them about
# owner replies. SHARET_NOTIFY_EMAIL_TO is optional and adds an owner fallback.
SHARET_NOTIFY_EMAIL_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Signed Trello webhooks deliver normal web/mobile replies immediately. This
# scan remains as a recovery path when a webhook is delayed or unavailable.
SHARET_REPLY_POLL_INTERVAL_MS=60000
# Verified browser sessions expire automatically; range is clamped to 1-365 days.
SHARET_PARTICIPANT_SESSION_DAYS=90

# Security Secrets (Required for Production)
# Change these in a production environment
JWT_SECRET=super_secret_jwt_key_development_only
JWT_EXPIRES_IN=7d
SESSION_SECRET=super_secret_session_key_development_only
ENCRYPTION_KEY=super_secret_32_character_encryption_key_123

# PouchDB Configuration
# Data is stored locally in ./data directory by default.
DATA_DIR=./data

# Optional: CouchDB Cloud Sync
# Uncomment and configure to enable cloud sync.
# COUCHDB_URL=https://your-couchdb-server.com
# COUCHDB_AUTH={"username":"admin","password":"password"}

# Optional prepaid resource billing. Leave off until docs/BILLING.md is completed.
BILLING_MODE=off
BILLING_PUBLIC_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLING_METER_KEY=
BILLING_RATE_CARD_FILE=
BILLING_METER_READY=false
BILLING_LIVE_APPROVED=false
BILLING_STRIPE_TAX=false
