--- /dev/null
+++ b/test/prototype-own-key-regression.js
@@ -0,0 +1,18 @@
+var merge = require('../')
+var test = require('tape')
+
+test('own prototype keys never alter the returned prototype', function(t) {
+	var owned = JSON.parse('{"__proto__":{"admin":true},"safe":1}')
+	var fromTarget = merge(owned, {})
+	t.equal(Object.getPrototypeOf(fromTarget), Object.prototype, 'target key does not change prototype')
+	t.notOk(fromTarget.admin, 'target key does not create inherited property')
+	t.equal(fromTarget.safe, 1, 'ordinary target properties survive')
+	var fromSource = merge(Object.create(null), owned)
+	t.equal(Object.getPrototypeOf(fromSource), Object.prototype, 'null-prototype target does not expose setter')
+	t.notOk(fromSource.admin, 'source key does not create inherited property')
+	t.equal(fromSource.safe, 1, 'ordinary source properties survive')
+	var symbol = Symbol('normal')
+	var object = {}; object[symbol] = 'kept'
+	t.equal(merge({}, object)[symbol], 'kept', 'symbol keys survive')
+	t.end()
+})
